'use client';

import { useDashboardData } from '@/hooks/useDashboardData';
import { StatsCard } from '@/components/dashboard/StatsCard';
import { KPIGrid } from '@/components/dashboard/KPIGrid';
import { RecentTransactions } from '@/components/dashboard/RecentTransactions';
import { ForecastChart } from '@/components/dashboard/ForecastChart';
import { SystemStatus } from '@/components/dashboard/SystemStatus';
import { QuickActionsCard } from '@/components/dashboard/QuickActionsCard';
import { Loading } from '@/components/common/Loading';

export default function DashboardPage() {
  const { data, isLoading, error } = useDashboardData();

  // 1. Guard: Loading state
  if (isLoading) {
    return (
      <div className="flex min-h-[60vh] items-center justify-center">
        <Loading size="lg" />
      </div>
    );
  }

  // 2. Guard: Data null (API error / not ready)
  if (!data) {
    return (
      <div className="flex min-h-[60vh] items-center justify-center">
        <div className="text-center text-gray-500 dark:text-gray-400">
          <p className="text-lg font-semibold">Tidak ada data</p>
          <p className="text-sm">Coba refresh halaman.</p>
        </div>
      </div>
    );
  }

  // 3. Guard: Error state
  if (error) {
    return (
      <div className="flex min-h-[60vh] items-center justify-center">
        <div className="text-center text-red-600 dark:text-red-400">
          <p className="text-lg font-semibold">Gagal memuat data</p>
          <p className="text-sm">{error.message || 'Terjadi kesalahan'}</p>
        </div>
      </div>
    );
  }

  const { total_sku, total_warehouse, low_stock_count, anomaly_count, health, recent_transactions, forecast } = data;
  const healthStatus = health?.status === 'online' ? 'online' : 'offline';

  return (
    <div className="space-y-6">
      <div>
        <h1 className="text-2xl font-bold text-gray-900 dark:text-white">Dashboard</h1>
        <p className="text-gray-500 dark:text-gray-400">Ringkasan supply chain Anda</p>
      </div>

      <KPIGrid
        totalSku={total_sku || 0}
        totalWarehouse={total_warehouse || 0}
        lowStockCount={low_stock_count || 0}
        anomalyCount={anomaly_count || 0}
      />

      <div className="grid grid-cols-1 gap-6 lg:grid-cols-3">
        <div className="lg:col-span-2">
          <ForecastChart data={forecast || []} />
        </div>
        <div className="space-y-6">
          <SystemStatus status={healthStatus} />
          <QuickActionsCard />
        </div>
      </div>

      <RecentTransactions transactions={recent_transactions || []} />
    </div>
  );
}
